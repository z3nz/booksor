{
  "name": "booksor",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "data": "node scripts/fetch-sources.ts && node scripts/build-db.ts && node scripts/export-static.ts",
    "xref:update": "curl -fL -o data/cross-references.zip https://a.openbible.info/data/cross-references.zip && pnpm data",
    "deploy": "astro build && node scripts/deploy-all.ts",
    "deploy:all": "node scripts/deploy-all.ts",
    "split": "node scripts/split-dist.ts",
    "deploy:www": "wrangler deploy --config workers/www-redirect/wrangler.jsonc",
    "ci:build": "pnpm data && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/svelte": "^9.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "astro": "^7.4.12",
    "minisearch": "^7.2.0",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "fflate": "^0.8.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
