---
import '@fontsource-variable/literata';
import '@fontsource-variable/inter';
import '../styles/global.css';
import SearchBox from '../components/SearchBox.svelte';
import TranslationSwitcher from '../components/TranslationSwitcher.svelte';
import ReaderSettings from '../components/ReaderSettings.svelte';
import ListenPlayer from '../components/ListenPlayer.svelte';
import { ClientRouter } from 'astro:transitions';
import { homeUrl, LANGUAGE_NAMES, messages, UI_LANGS, uiLang, type UiLang } from '../i18n/index.ts';
import { iconSvg } from '../lib/icons.ts';
import { languageOf, TRANSLATIONS } from '../lib/translations.ts';

interface Props {
  title: string;
  description: string;
  /** Translation this page shows. Pages without one (home, about) follow the reader's saved choice. */
  translation?: string;
  /** Where the translation switcher should keep you: the path after the translation, e.g. "john/3" */
  location?: string;
  showSearch?: boolean;
  /** Keep this page out of search engines (e.g. the reader's own Saved page) */
  noindex?: boolean;
  /** Menu language; defaults to the translation's language, else English */
  lang?: UiLang;
  /** The same page in other languages, for search engines: [language, path] */
  alternates?: [string, string][];
}

const { title, description, translation, location, showSearch = true, noindex = false, alternates = [] } = Astro.props;
const lang = Astro.props.lang ?? uiLang(languageOf(translation));
const m = messages(lang);
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(([hreflang, path]) => <link rel="alternate" hreflang={hreflang} href={new URL(path, Astro.site)} />)}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Booksor" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbf8f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Booksor" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <!--
      Apply saved theme, text size, focus and study mode before the page paints (no flash). Pages change
      without a full reload, which resets these on <html>, so they're applied again after each swap.
    -->
    <script is:inline>
      (() => {
        const apply = (doc) => {
          try {
            const s = JSON.parse(localStorage.getItem('booksor:settings') || '{}');
            const r = doc.documentElement;
            if (s.theme && s.theme !== 'system') r.dataset.theme = s.theme;
            if (s.size) r.style.setProperty('--reader-size', s.size + 'px');
            r.toggleAttribute('data-focus', !!s.focus);
            r.toggleAttribute('data-study', !!s.study);
            r.toggleAttribute('data-offline', !navigator.onLine);
          } catch {}
        };
        apply(document);
        if (!window.booksorSwapHook) {
          window.booksorSwapHook = true;
          // Set them on the incoming page before it's shown
          document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{m.site.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={homeUrl(lang)} aria-label={m.site.home}>
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <path d="M4 7.5C4 6.7 4.7 6 5.5 6H13a3 3 0 0 1 3 3v17a2.5 2.5 0 0 0-2.5-2.5H5.5C4.7 23.5 4 22.8 4 22z" fill="var(--accent)" />
            <path d="M28 7.5C28 6.7 27.3 6 26.5 6H19a3 3 0 0 0-3 3v17a2.5 2.5 0 0 1 2.5-2.5h8c.8 0 1.5-.7 1.5-1.5z" fill="var(--accent)" opacity=".65" />
          </svg>
          <span>Booksor</span>
        </a>
        {
          showSearch && (
            <div class="header-search">
              <SearchBox client:idle variant="compact" translation={translation} lang={lang} />
            </div>
          )
        }
        <div class="header-actions">
          <span class="offline-pill" role="status" title={m.site.offlineTitle}>{m.site.offline}</span>
          <TranslationSwitcher client:load current={translation} location={location} lang={lang} />
          <a class="btn btn-icon" href="/saved" aria-label={m.site.savedLabel} title={m.site.saved} set:html={iconSvg('bookmark', 18)} />
          <ReaderSettings client:load transition:persist="reader-settings" lang={lang} />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>{m.site.tagline}</p>
        <nav aria-label={m.site.footer}>
          {lang === 'en' && <a href="/help">{m.site.hardTimes}</a>}
          <a href="/saved">{m.site.saved}</a>
          <a href="/about">{m.site.about}</a>
          {TRANSLATIONS.filter((t) => t.language === lang).map((t) => <a href={`/${t.id}`} lang={t.language}>{t.abbr}</a>)}
        </nav>
        <!-- Every language, folded into one small menu so the footer stays short however many there are -->
        <details class="languages">
          <summary aria-label={`${m.site.languages}: ${LANGUAGE_NAMES[lang]}`}>
            <span set:html={iconSvg('globe', 16)} />
            {LANGUAGE_NAMES[lang]}
          </summary>
          <ul>
            {
              UI_LANGS.map((l) => (
                <li>
                  {l === lang ? (
                    <span aria-current="true">{LANGUAGE_NAMES[l]}</span>
                  ) : (
                    <a href={homeUrl(l)} lang={l} hreflang={l}>
                      {LANGUAGE_NAMES[l]}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </details>
      </div>
    </footer>
    <!-- Keeps reading aloud as you move between pages -->
    <ListenPlayer client:load transition:persist="listen-player" />
  </body>
</html>

<script>
  // Install as an app: browsers that support it fire this once; the settings panel shows the button
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    (window as { booksorInstall?: Event }).booksorInstall = e;
    window.dispatchEvent(new Event('booksor:installable'));
  });

  // Offline: save pages as they're read (production only, so development always shows fresh code)
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
  }

  // The footer language menu closes on a click elsewhere or Escape, like other menus
  const closeLanguages = (e: Event) => {
    const menu = document.querySelector<HTMLDetailsElement>('details.languages[open]');
    if (!menu) return;
    if (e instanceof KeyboardEvent ? e.key === 'Escape' : !menu.contains(e.target as Node)) {
      menu.open = false;
      if (e instanceof KeyboardEvent) menu.querySelector('summary')?.focus();
    }
  };
  document.addEventListener('click', closeLanguages);
  document.addEventListener('keydown', closeLanguages);

  // (also set before each page swap by the inline script in <head>)
  const showConnection = () => document.documentElement.toggleAttribute('data-offline', !navigator.onLine);
  showConnection();
  window.addEventListener('online', showConnection);
  window.addEventListener('offline', showConnection);
</script>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 100;
    background: var(--surface);
    padding: 8px 12px;
    border-radius: 8px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    min-height: 60px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-family: var(--font-reading);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .offline-pill {
    display: none;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }
  :global(:root[data-offline]) .offline-pill {
    display: inline-flex;
  }
  .header-search {
    order: 3;
    flex: 1 1 100%;
  }
  @media (min-width: 760px) {
    .header-search {
      order: 0;
      flex: 1 1 auto;
      max-width: 520px;
    }
  }
  main {
    min-height: 70vh;
  }
  .site-footer {
    margin-top: 64px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 24px;
    padding-bottom: 32px;
  }
  .footer-inner p {
    margin: 0;
  }
  .footer-inner nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-inner a {
    color: var(--muted);
  }
  .languages {
    position: relative;
  }
  .languages summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    list-style: none;
  }
  .languages summary::-webkit-details-marker {
    display: none;
  }
  .languages summary::after {
    content: '▾';
    font-size: 12px;
  }
  .languages summary span {
    display: inline-flex;
  }
  /* Opens upwards, since it sits at the bottom of the page */
  .languages ul {
    position: absolute;
    bottom: calc(100% + 8px);
    inset-inline-start: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(2, minmax(8em, auto));
    gap: 2px 8px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }
  .languages li > * {
    display: block;
    padding: 6px 8px;
    border-radius: 8px;
  }
  .languages a {
    text-decoration: none;
  }
  .languages a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .languages [aria-current] {
    color: var(--text);
    font-weight: 600;
  }
</style>
