---
import '@fontsource-variable/literata';
import '@fontsource-variable/inter';
import '../styles/global.css';
import SearchBox from '../components/SearchBox.svelte';
import TranslationSwitcher from '../components/TranslationSwitcher.svelte';
import ReaderSettings from '../components/ReaderSettings.svelte';
import { iconSvg } from '../lib/icons.ts';
import { TRANSLATIONS } from '../lib/translations.ts';

interface Props {
  title: string;
  description: string;
  /** Translation this page shows. Pages without one (home, about) follow the reader's saved choice. */
  translation?: string;
  /** Where the translation switcher should keep you: the path after the translation, e.g. "john/3" */
  location?: string;
  showSearch?: boolean;
  /** Keep this page out of search engines (e.g. the reader's own Saved page) */
  noindex?: boolean;
}

const { title, description, translation, location, showSearch = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Booksor" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbf8f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Booksor" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <!-- Apply saved theme and text size before the page paints (no flash). -->
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem('booksor:settings') || '{}');
        const r = document.documentElement;
        if (s.theme && s.theme !== 'system') r.dataset.theme = s.theme;
        if (s.size) r.style.setProperty('--reader-size', s.size + 'px');
        if (s.focus) r.setAttribute('data-focus', '');
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label="Booksor home">
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <path d="M4 7.5C4 6.7 4.7 6 5.5 6H13a3 3 0 0 1 3 3v17a2.5 2.5 0 0 0-2.5-2.5H5.5C4.7 23.5 4 22.8 4 22z" fill="var(--accent)" />
            <path d="M28 7.5C28 6.7 27.3 6 26.5 6H19a3 3 0 0 0-3 3v17a2.5 2.5 0 0 1 2.5-2.5h8c.8 0 1.5-.7 1.5-1.5z" fill="var(--accent)" opacity=".65" />
          </svg>
          <span>Booksor</span>
        </a>
        {
          showSearch && (
            <div class="header-search">
              <SearchBox client:idle variant="compact" translation={translation} />
            </div>
          )
        }
        <div class="header-actions">
          <span class="offline-pill" role="status" title="No connection. Saved pages still work.">Offline</span>
          <TranslationSwitcher client:load current={translation} location={location} />
          <a class="btn btn-icon" href="/saved" aria-label="Saved highlights, notes and bookmarks" title="Saved" set:html={iconSvg('bookmark', 18)} />
          <ReaderSettings client:load />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>Booksor — read, search and share the Bible. Free, no ads, no tracking.</p>
        <nav aria-label="Footer">
          <a href="/help">Verses for hard times</a>
          <a href="/saved">Saved</a>
          <a href="/about">About &amp; licenses</a>
          {TRANSLATIONS.map((t) => <a href={`/${t.id}`}>{t.abbr}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  // Install as an app: browsers that support it fire this once; the settings panel shows the button
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    (window as { booksorInstall?: Event }).booksorInstall = e;
    window.dispatchEvent(new Event('booksor:installable'));
  });

  // Offline: save pages as they're read (production only, so development always shows fresh code)
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
  }

  const showConnection = () => document.documentElement.toggleAttribute('data-offline', !navigator.onLine);
  showConnection();
  window.addEventListener('online', showConnection);
  window.addEventListener('offline', showConnection);
</script>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 100;
    background: var(--surface);
    padding: 8px 12px;
    border-radius: 8px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    min-height: 60px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-family: var(--font-reading);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .offline-pill {
    display: none;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }
  :global(:root[data-offline]) .offline-pill {
    display: inline-flex;
  }
  .header-search {
    order: 3;
    flex: 1 1 100%;
  }
  @media (min-width: 760px) {
    .header-search {
      order: 0;
      flex: 1 1 auto;
      max-width: 520px;
    }
  }
  main {
    min-height: 70vh;
  }
  .site-footer {
    margin-top: 64px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 24px;
    padding-bottom: 32px;
  }
  .footer-inner p {
    margin: 0;
  }
  .footer-inner nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-inner a {
    color: var(--muted);
  }
</style>
