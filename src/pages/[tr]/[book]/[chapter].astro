---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import ChapterPicker from '../../../components/ChapterPicker.svelte';
import CrossRefs from '../../../components/CrossRefs.svelte';
import ReadingTools from '../../../components/ReadingTools.svelte';
import VerseActions from '../../../components/VerseActions.svelte';
import { BOOKS, adjacentChapter, chapterUrl } from '../../../lib/books.ts';
import { getChapter, getXrefCounts } from '../../../lib/db.ts';
import { plainText, verseHtml } from '../../../lib/text.ts';
import { defaultTranslationFor, TRANSLATION_LANGUAGES, TRANSLATIONS } from '../../../lib/translations.ts';
import { bookName, messages, uiLang } from '../../../i18n/index.ts';
import type { Translation, Verse } from '../../../lib/types.ts';

export const getStaticPaths = (() =>
  TRANSLATIONS.flatMap((t) =>
    BOOKS.flatMap((book, bookIdx) =>
      Array.from({ length: book.chapters }, (_, i) => ({
        params: { tr: t.id, book: book.slug, chapter: String(i + 1) },
        props: { t, bookIdx },
      })),
    ),
  )) satisfies GetStaticPaths;

interface Props {
  t: Translation;
  bookIdx: number;
}

const { t, bookIdx } = Astro.props;
const book = BOOKS[bookIdx];
const chapter = Number(Astro.params.chapter);
const verses = getChapter(t.id, bookIdx, chapter);
const xrefCounts = getXrefCounts(bookIdx, chapter);

// Flow verses into paragraphs when the translation marks them; otherwise (and for poetry) one verse per line.
const poetry = ['PSA', 'PRO'].includes(book.code);
const flow = !poetry && verses.some((v) => v.p);
const groups: Verse[][] = [];
for (const v of verses) {
  if (!groups.length || !flow || v.p) groups.push([v]);
  else groups[groups.length - 1].push(v);
}

const prev = adjacentChapter(book, chapter, -1);
const next = adjacentChapter(book, chapter, 1);
const lang = uiLang(t.language);
const m = messages(lang);
const name = bookName(book, lang);
const intro = plainText(verses.slice(0, 3).map((v) => v.t).join(' '), t.suppliedWords);
const description = `${name} ${chapter} (${t.abbr}): ${intro.length > 150 ? intro.slice(0, 147).trimEnd() + '…' : intro}`;
// The main translation in each language points search engines at the others
const alternates: [string, string][] =
  defaultTranslationFor(t.language) === t.id
    ? TRANSLATION_LANGUAGES.map((l) => [l, chapterUrl(defaultTranslationFor(l), book, chapter)])
    : [];
---

<Base
  title={m.chapter.title(name, chapter, t.abbr)}
  description={description}
  translation={t.id}
  location={`${book.slug}/${chapter}`}
  alternates={alternates}
>
  <article
    class="chapter container"
    data-title={`${name} ${chapter}`}
    data-intro={m.chapter.intro(name, chapter)}
    data-lang={t.language}
    data-tr={t.id}
    data-slug={book.slug}
    data-book={bookIdx}
    data-chapter={chapter}
  >
    <header class="chapter-head">
      <div class="eyebrow">{t.name}</div>
      <ChapterPicker client:idle tr={t.id} slug={book.slug} chapter={chapter} lang={lang} />
      <ReadingTools client:load nextUrl={next ? chapterUrl(t.id, next.book, next.chapter) : null} lang={lang} />
    </header>

    <div class:list={['verses', 'reading', flow ? 'flow' : 'lines']} lang={t.language} dir={t.dir}>
      {
        groups.map((group, gi) => (
          <p>
            {gi === 0 && (
              <span class="chapnum" aria-hidden="true">
                {chapter}
              </span>
            )}
            {group.map((v) => (
              <>
                <span class="verse" id={`v${v.v}`} data-v={v.v}>
                  <sup class="vn">{v.v}</sup>
                  <span class="vt" set:html={verseHtml(v.t, t.suppliedWords)} />
                  {xrefCounts.get(v.v) && (
                    <button class="xn" data-xv={v.v} aria-label={m.chapter.relatedCount(xrefCounts.get(v.v)!, v.v)}>
                      {xrefCounts.get(v.v)}
                    </button>
                  )}
                </span>{' '}
              </>
            ))}
          </p>
        ))
      }
    </div>

    <nav class="pager" aria-label={m.chapter.chapters}>
      {
        prev ? (
          <a class="btn" href={chapterUrl(t.id, prev.book, prev.chapter)} data-nav="prev" rel="prev">
            <span class="flip" aria-hidden="true">←</span> {bookName(prev.book, lang)} {prev.chapter}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="btn" href={chapterUrl(t.id, next.book, next.chapter)} data-nav="next" rel="next">
            {bookName(next.book, lang)} {next.chapter} <span class="flip" aria-hidden="true">→</span>
          </a>
        )
      }
    </nav>

    <p class="attribution">{t.attribution} <a href="/about">{m.chapter.licenses}</a></p>
  </article>

  <VerseActions client:load tr={t.id} abbr={t.abbr} bookName={name} bookIdx={bookIdx} chapter={chapter} lang={lang} />
  <!-- Stays open as you follow references from chapter to chapter -->
  <CrossRefs client:load transition:persist="cross-refs" />
</Base>

<script>
  import { navigate } from 'astro:transitions/client';
  import { recordHistory, saveLastRead } from '../../../lib/prefs.ts';

  // Pages change without a full reload, so set up each chapter on every page load
  let stopTracking: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    stopTracking?.();
    stopTracking = undefined;
    if (!document.querySelector('article.chapter[data-title]')) return;

    // Remember where the reader is, for "Continue reading" and the offline page
    const path = window.location.pathname.replace(/\.html$/, '');
    const [, , slug, chapter] = path.split('/');
    const verses = [...document.querySelectorAll<HTMLElement>('.verses .verse[data-v]')];
    const remember = () => {
      const onScreen = verses.find((el) => el.getBoundingClientRect().bottom > 90);
      saveLastRead({ slug, chapter: parseInt(chapter, 10), verse: Number(onScreen?.dataset.v ?? 1) });
    };
    let pending = 0;
    const onScroll = () => {
      clearTimeout(pending);
      pending = window.setTimeout(remember, 500);
    };
    remember();
    recordHistory(path);
    window.addEventListener('scroll', onScroll, { passive: true });
    stopTracking = () => {
      clearTimeout(pending);
      window.removeEventListener('scroll', onScroll);
    };
  });

  // ← / → move between chapters (added once; works on whichever chapter is showing). Right to left, ← is next.
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable="true"]')) return;
    if (document.querySelector('dialog[open]')) return;
    const forward = document.documentElement.dir === 'rtl' ? 'ArrowLeft' : 'ArrowRight';
    const back = forward === 'ArrowLeft' ? 'ArrowRight' : 'ArrowLeft';
    const rel = e.key === forward ? 'next' : e.key === back ? 'prev' : null;
    const link = rel && document.querySelector<HTMLAnchorElement>(`.chapter a[data-nav="${rel}"]`);
    if (link) void navigate(link.href);
  });
</script>

<style is:global>
.chapter {
    max-width: 720px;
    padding-top: 28px;
  }
.chapter-head {
    margin-bottom: 20px;
  }
.chapter .verses {
    font-size: var(--reader-size);
    line-height: 1.75;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
.chapter .verses p {
    margin: 0 0 0.9em;
  }
.chapter .chapnum {
    float: inline-start;
    margin-block: 0.06em 0;
    margin-inline: 0 0.18em;
    font-size: 3.6em;
    font-weight: 600;
    line-height: 0.95;
    color: var(--accent);
  }
.chapter .chapnum + .verse .vn {
    display: none;
  }
.chapter .lines .verse {
    display: block;
    margin-bottom: 0.45em;
  }
.chapter .lines .chapnum {
    font-size: 2.6em;
  }
.chapter .verse {
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
.chapter .verse[data-hl] {
    background: var(--hl);
    box-shadow: 0 0 0 2px var(--hl);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
.chapter .verse[data-hl='yellow'] { --hl: var(--hl-yellow); }
.chapter .verse[data-hl='green'] { --hl: var(--hl-green); }
.chapter .verse[data-hl='blue'] { --hl: var(--hl-blue); }
.chapter .verse[data-hl='pink'] { --hl: var(--hl-pink); }
.chapter .verse[data-hl='purple'] { --hl: var(--hl-purple); }
.chapter .verse.speaking {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
.chapter .verse.target {
    background: var(--highlight);
    box-shadow: 0 0 0 3px var(--highlight);
  }
.chapter .verse.selected {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
    text-decoration: underline dotted color-mix(in srgb, var(--accent) 60%, transparent);
    text-underline-offset: 4px;
  }
.chapter .vn {
    margin-inline-end: 0.2em;
    font-family: var(--font-ui);
    font-size: 0.58em;
    font-weight: 600;
    color: var(--verse-num);
    user-select: none;
  }
.chapter .mark-icon {
    display: inline-flex;
    vertical-align: -0.1em;
    color: var(--accent);
  }
.chapter .bm-icon {
    margin-inline-end: 0.15em;
  }
.chapter .note-btn {
    margin-inline-start: 0.25em;
    padding: 2px;
    border: 0;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    cursor: pointer;
  }
.chapter .note-btn:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
.chapter .vt em.added {
    font-style: italic;
    opacity: 0.85;
  }
.chapter .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 40px;
  }
.chapter {
    padding-bottom: calc(var(--listen-space, 0px) + var(--scroll-space, 0px));
  }
/* Focus mode: just the text */
:root[data-focus]:has(.chapter) .site-header,
:root[data-focus]:has(.chapter) .site-footer,
:root[data-focus] .chapter .eyebrow,
:root[data-focus] .chapter .attribution {
    display: none;
  }
:root[data-focus] .chapter {
    max-width: 660px;
    padding-top: 56px;
    /* The footer is hidden, so leave room below the chapter buttons */
    padding-bottom: calc(56px + var(--listen-space, 0px) + var(--scroll-space, 0px) + env(safe-area-inset-bottom));
  }
.chapter .xn {
    display: none;
  }
/* Study mode: how many related passages each verse has; tap to see them */
:root[data-study] .chapter .xn {
    display: inline-block;
    min-width: 1.7em;
    margin-inline-start: 0.3em;
    padding: 0 0.4em;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
    color: var(--accent);
    font: 600 11px/1.6 var(--font-ui, system-ui, sans-serif);
    vertical-align: 0.25em;
    cursor: pointer;
  }
:root[data-study] .chapter .xn:hover {
    background: color-mix(in srgb, var(--accent) 15%, var(--surface));
  }
:root[data-focus] .chapter .verses {
    line-height: 1.85;
  }
.chapter .attribution {
    margin-top: 32px;
    color: var(--muted);
    font-size: 13px;
  }
</style>
