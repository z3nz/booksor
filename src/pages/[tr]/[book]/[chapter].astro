---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import ChapterPicker from '../../../components/ChapterPicker.svelte';
import ReadingTools from '../../../components/ReadingTools.svelte';
import VerseActions from '../../../components/VerseActions.svelte';
import { BOOKS, adjacentChapter, chapterUrl } from '../../../lib/books.ts';
import { getChapter } from '../../../lib/db.ts';
import { plainText, verseHtml } from '../../../lib/text.ts';
import { TRANSLATIONS } from '../../../lib/translations.ts';
import type { Translation, Verse } from '../../../lib/types.ts';

export const getStaticPaths = (() =>
  TRANSLATIONS.flatMap((t) =>
    BOOKS.flatMap((book, bookIdx) =>
      Array.from({ length: book.chapters }, (_, i) => ({
        params: { tr: t.id, book: book.slug, chapter: String(i + 1) },
        props: { t, bookIdx },
      })),
    ),
  )) satisfies GetStaticPaths;

interface Props {
  t: Translation;
  bookIdx: number;
}

const { t, bookIdx } = Astro.props;
const book = BOOKS[bookIdx];
const chapter = Number(Astro.params.chapter);
const verses = getChapter(t.id, bookIdx, chapter);

// Flow verses into paragraphs when the translation marks them; otherwise (and for poetry) one verse per line.
const poetry = ['PSA', 'PRO'].includes(book.code);
const flow = !poetry && verses.some((v) => v.p);
const groups: Verse[][] = [];
for (const v of verses) {
  if (!groups.length || !flow || v.p) groups.push([v]);
  else groups[groups.length - 1].push(v);
}

const prev = adjacentChapter(book, chapter, -1);
const next = adjacentChapter(book, chapter, 1);
const intro = plainText(verses.slice(0, 3).map((v) => v.t).join(' '), t.suppliedWords);
const description = `${book.name} ${chapter} (${t.abbr}): ${intro.length > 150 ? intro.slice(0, 147).trimEnd() + '…' : intro}`;
---

<Base
  title={`${book.name} ${chapter} (${t.abbr}) – Booksor`}
  description={description}
  translation={t.id}
  location={`${book.slug}/${chapter}`}
>
  <article class="chapter container">
    <header class="chapter-head">
      <div class="eyebrow">{t.name}</div>
      <ChapterPicker client:idle tr={t.id} slug={book.slug} chapter={chapter} />
      <ReadingTools
        client:load
        lang={t.language}
        intro={`${book.name}, chapter ${chapter}`}
        nextUrl={next ? chapterUrl(t.id, next.book, next.chapter) : null}
      />
    </header>

    <div class:list={['verses', 'reading', flow ? 'flow' : 'lines']} lang={t.language} dir={t.dir}>
      {
        groups.map((group, gi) => (
          <p>
            {gi === 0 && (
              <span class="chapnum" aria-hidden="true">
                {chapter}
              </span>
            )}
            {group.map((v) => (
              <>
                <span class="verse" id={`v${v.v}`} data-v={v.v}>
                  <sup class="vn">{v.v}</sup>
                  <span class="vt" set:html={verseHtml(v.t, t.suppliedWords)} />
                </span>{' '}
              </>
            ))}
          </p>
        ))
      }
    </div>

    <nav class="pager" aria-label="Chapters">
      {
        prev ? (
          <a class="btn" href={chapterUrl(t.id, prev.book, prev.chapter)} data-nav="prev" rel="prev">
            ← {prev.book.name} {prev.chapter}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="btn" href={chapterUrl(t.id, next.book, next.chapter)} data-nav="next" rel="next">
            {next.book.name} {next.chapter} →
          </a>
        )
      }
    </nav>

    <p class="attribution">{t.attribution} <a href="/about">Licenses</a></p>
  </article>

  <VerseActions client:load tr={t.id} abbr={t.abbr} bookName={book.name} bookIdx={bookIdx} chapter={chapter} />
</Base>

<script>
  import { recordHistory, saveLastRead } from '../../../lib/prefs.ts';

  // Remember where the reader is, for "Continue reading" on the home page
  const [, , slug, chapter] = window.location.pathname.split('/');
  const verses = [...document.querySelectorAll<HTMLElement>('.verses .verse[data-v]')];
  const remember = () => {
    const onScreen = verses.find((el) => el.getBoundingClientRect().bottom > 90);
    saveLastRead({ slug, chapter: parseInt(chapter, 10), verse: Number(onScreen?.dataset.v ?? 1) });
  };
  let pending = 0;
  remember();
  recordHistory(window.location.pathname.replace(/\.html$/, ''));
  window.addEventListener('scroll', () => {
    clearTimeout(pending);
    pending = window.setTimeout(remember, 500);
  }, { passive: true });

  // ← / → move between chapters
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable="true"]')) return;
    if (document.querySelector('dialog[open]')) return;
    const rel = e.key === 'ArrowRight' ? 'next' : e.key === 'ArrowLeft' ? 'prev' : null;
    const link = rel && document.querySelector<HTMLAnchorElement>(`a[data-nav="${rel}"]`);
    if (link) window.location.href = link.href;
  });
</script>

<style is:global>
.chapter {
    max-width: 720px;
    padding-top: 28px;
  }
.chapter-head {
    margin-bottom: 20px;
  }
.chapter .verses {
    font-size: var(--reader-size);
    line-height: 1.75;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
.chapter .verses p {
    margin: 0 0 0.9em;
  }
.chapter .chapnum {
    float: left;
    margin: 0.06em 0.18em 0 0;
    font-size: 3.6em;
    font-weight: 600;
    line-height: 0.95;
    color: var(--accent);
  }
.chapter .chapnum + .verse .vn {
    display: none;
  }
.chapter .lines .verse {
    display: block;
    margin-bottom: 0.45em;
  }
.chapter .lines .chapnum {
    font-size: 2.6em;
  }
.chapter .verse {
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
.chapter .verse[data-hl] {
    background: var(--hl);
    box-shadow: 0 0 0 2px var(--hl);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
.chapter .verse[data-hl='yellow'] { --hl: var(--hl-yellow); }
.chapter .verse[data-hl='green'] { --hl: var(--hl-green); }
.chapter .verse[data-hl='blue'] { --hl: var(--hl-blue); }
.chapter .verse[data-hl='pink'] { --hl: var(--hl-pink); }
.chapter .verse[data-hl='purple'] { --hl: var(--hl-purple); }
.chapter .verse.speaking {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
.chapter .verse.target {
    background: var(--highlight);
    box-shadow: 0 0 0 3px var(--highlight);
  }
.chapter .verse.selected {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
    text-decoration: underline dotted color-mix(in srgb, var(--accent) 60%, transparent);
    text-underline-offset: 4px;
  }
.chapter .vn {
    margin-right: 0.2em;
    font-family: var(--font-ui);
    font-size: 0.58em;
    font-weight: 600;
    color: var(--verse-num);
    user-select: none;
  }
.chapter .mark-icon {
    display: inline-flex;
    vertical-align: -0.1em;
    color: var(--accent);
  }
.chapter .bm-icon {
    margin-right: 0.15em;
  }
.chapter .note-btn {
    margin-left: 0.25em;
    padding: 2px;
    border: 0;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    cursor: pointer;
  }
.chapter .note-btn:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
.chapter .vt em.added {
    font-style: italic;
    opacity: 0.85;
  }
.chapter .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 40px;
  }
.chapter {
    padding-bottom: var(--player-space, 0px);
  }
/* Focus mode: just the text */
:root[data-focus]:has(.chapter) .site-header,
:root[data-focus]:has(.chapter) .site-footer,
:root[data-focus] .chapter .eyebrow,
:root[data-focus] .chapter .attribution {
    display: none;
  }
:root[data-focus] .chapter {
    max-width: 660px;
    padding-top: 56px;
    /* The footer is hidden, so leave room below the chapter buttons */
    padding-bottom: calc(56px + var(--player-space, 0px) + env(safe-area-inset-bottom));
  }
:root[data-focus] .chapter .verses {
    line-height: 1.85;
  }
.chapter .attribution {
    margin-top: 32px;
    color: var(--muted);
    font-size: 13px;
  }
</style>
